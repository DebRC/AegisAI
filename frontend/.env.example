# Server-only FastAPI address used by future Next.js route handlers.
API_BASE_URL=http://backend:8000

# Local Compose uses HTTP. Set true behind HTTPS in deployed environments.
SESSION_COOKIE_SECURE=false

# Must not outlive FastAPI's refresh-token lifetime.
SESSION_REFRESH_COOKIE_MAX_AGE_SECONDS=604800

# Public, non-sensitive display configuration only.
NEXT_PUBLIC_APP_NAME=AegisAI
