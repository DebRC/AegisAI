# Copy this file to secrets.env, replace every placeholder, and keep it local.
# secrets.env is ignored by Git and is loaded into the `aegisai-secrets` Secret.
POSTGRES_PASSWORD=replace-with-a-long-random-postgresql-password
DATABASE_URL=postgresql://aegis:replace-with-the-same-postgresql-password@postgres:5432/aegis
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
SSO_STATE_SECRET_KEY=replace-with-a-different-long-random-sso-state-secret
OPENAI_API_KEY=
QDRANT_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
