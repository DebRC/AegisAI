APP_NAME=AegisAI
APP_VERSION=0.1.0
APP_ENV=development

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis

QDRANT_URL=http://qdrant:6333

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enterprise SSO is disabled until Phase 5 provider credentials are configured.
# In deployed environments, use the public HTTPS URL that providers can redirect to.
SSO_ENABLED=false
SSO_CALLBACK_BASE_URL=http://localhost:8000
# Use a distinct, long random secret to sign temporary OAuth state values.
SSO_STATE_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_SECRET
# Browser SSO transaction lifetime; keep this short to limit replay exposure.
SSO_TRANSACTION_EXPIRE_MINUTES=5

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth application
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra ID OpenID Connect application.
# Use a directory (tenant) ID to restrict sign-in to one Entra tenant, or
# "organizations" to permit organizational Microsoft accounts.
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_TENANT_ID=organizations
