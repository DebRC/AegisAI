APP_NAME=AegisAI
APP_VERSION=0.1.0
APP_ENV=development

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis

QDRANT_URL=http://qdrant:6333
# Empty for local Docker Qdrant. Set only when the target Qdrant deployment
# requires authentication; never commit a real key.
QDRANT_API_KEY=
# Collection shape is immutable after creation. Changing model or dimension
# requires a new collection and deliberate reindexing.
QDRANT_COLLECTION_NAME=aegis_document_chunks_v1
QDRANT_TIMEOUT_SECONDS=10

# Phase 9's first provider is OpenAI text-embedding-3-small (1,536 dimensions).
# Leave the API key empty until embedding workers are enabled in checkpoint 9.4.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VECTOR_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
OPENAI_API_KEY=

# Original-document storage for local Docker development.
DOCUMENT_STORAGE_PATH=/data/documents
# 25 MiB. The upload service will enforce this streamed byte limit.
DOCUMENT_MAX_UPLOAD_BYTES=26214400
# Phase 8 protects workers and PostgreSQL from expansion-heavy source files.
DOCUMENT_MAX_EXTRACTED_TEXT_CHARACTERS=5000000
# The deterministic, model-neutral chunking defaults used after extraction.
DOCUMENT_CHUNK_TARGET_CHARACTERS=1200
DOCUMENT_CHUNK_OVERLAP_CHARACTERS=200

# Celery uses Redis only as a delivery and short-lived result channel.
# PostgreSQL will remain the durable source of truth for processing jobs.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_DEFAULT_QUEUE=aegis-processing
CELERY_TASK_TIME_LIMIT_SECONDS=600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=540
# Celery Beat will sweep durable, unpublished outbox events at this interval.
PROCESSING_OUTBOX_DISPATCH_INTERVAL_SECONDS=30

JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Enterprise SSO is disabled until Phase 5 provider credentials are configured.
# In deployed environments, use the public HTTPS URL that providers can redirect to.
SSO_ENABLED=false
SSO_CALLBACK_BASE_URL=http://localhost:8000
# Use a distinct, long random secret to sign temporary OAuth state values.
SSO_STATE_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_SECRET
# Browser SSO transaction lifetime; keep this short to limit replay exposure.
SSO_TRANSACTION_EXPIRE_MINUTES=5

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth application
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Microsoft Entra ID OpenID Connect application.
# Use a directory (tenant) ID to restrict sign-in to one Entra tenant, or
# "organizations" to permit organizational Microsoft accounts.
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_TENANT_ID=organizations
